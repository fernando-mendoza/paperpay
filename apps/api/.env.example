PORT=4000
# En una VPS detrás de Caddy/nginx: 127.0.0.1. Sin valor escucha en todas las interfaces.
HOST=
NODE_ENV=development

# Sustituye por una cuenta G... de Stellar Testnet antes de liquidar pagos.
STELLAR_TREASURY_PUBLIC_KEY=GB6X402TREASURYDEMOUNAM2026GOYAHACKPAPERPAYTESTNET

# Solo para una demo local. En producción siempre se desactiva.
DEMO_PAYMENTS=false

# true: envía a Horizon una transacción clásica ya firmada por el lector.
SELF_SETTLE=false

# Integración externa aún sin prueba de liquidación real.
OPENZEPPELIN_CHANNELS_URL=https://channels.openzeppelin.com/x402/testnet
OPENZEPPELIN_API_KEY=

# Pago por el contrato de reparto 98/2 (contracts/splitter). Vacío = solo pagos clásicos.
# Contrato de testnet: ver contracts/deployments/testnet.json.
SPLITTER_CONTRACT_ID=
# Cuenta G... que recibe el 98% (editorial). Obligatoria si hay SPLITTER_CONTRACT_ID.
SPLITTER_PUBLISHER_ADDRESS=
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Verificación de transacciones que Pollar ya envió a Stellar.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
PAYMENT_VERIFICATION_MAX_AGE_SECONDS=300

# Archivo SQLite de recibos. Vacío: .data/receipts.db (local) o $STATE_DIRECTORY/receipts.db (systemd).
RECEIPTS_DB_PATH=

# Sustituye por un valor aleatorio largo. Es obligatorio en producción.
JWT_SECRET=replace-with-a-random-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
