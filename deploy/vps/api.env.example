# /etc/paperpay/api.env (root, 0600). systemd lo lee antes de bajar privilegios.
# HOST, PORT y NODE_ENV los fija la unit; aquí solo lo propio de cada despliegue.

# Cuenta G... de Stellar Testnet que recibe los pagos (pública, no es secreto).
STELLAR_TREASURY_PUBLIC_KEY=
# El navegador firma con Freighter y la API envía la transacción a Horizon.
SELF_SETTLE=true
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
PAYMENT_VERIFICATION_MAX_AGE_SECONDS=300
# Orígenes del frontend que llaman a la API directo (el proxy de Next no necesita CORS).
CORS_ORIGINS=https://paperpay.press
# JWT_SECRET no va en este ejemplo: se genera en el servidor (ver README).
