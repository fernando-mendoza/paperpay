# /etc/paperpay/api.env (root, 0600). systemd lo lee antes de bajar privilegios.
# HOST, PORT y NODE_ENV los fija la unit; aquí solo lo propio de cada despliegue.

# Cuenta G... de Stellar Testnet que recibe los pagos (pública, no es secreto).
STELLAR_TREASURY_PUBLIC_KEY=
# El navegador firma con Freighter y la API envía la transacción a Horizon.
SELF_SETTLE=true
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
PAYMENT_VERIFICATION_MAX_AGE_SECONDS=300
# Orígenes del frontend que llaman a la API directo (el proxy de Next no necesita CORS).
CORS_ORIGINS=https://paperpay.press
# JWT_SECRET no va en este ejemplo: se genera en el servidor (ver README).

# Contrato de reparto 98/2 (contracts/README.md). Sin estas dos, la API cobra solo con el pago
# clásico. Son públicas: el contrato v0.2.0 de testnet y la editorial demo.
SPLITTER_CONTRACT_ID=CAIMQYXIXNYSAXIRQRAAG5ZTWP26476JX4SVAMDAOXRKLRCADUDKHOR5
SPLITTER_PUBLISHER_ADDRESS=GA3MOPOJ374G4APKR4RE7VPXF5CEQKER3FA3LZ2XSAARIRSZEF6QXUZI
# Referidos (pay_ref, desde el contrato v0.4.0). Para activarlos, cambiar las líneas de arriba y
# estas tres juntas: la v0.2.0 queda como anterior para que sus regalos y lecturas sigan valiendo.
#   SPLITTER_CONTRACT_ID=CC5SIM7JV6TXMWABU7G3DAA3V7HROFBOBF7I5TW4JZHKAQPBFJUWADGA
#   SPLITTER_LEGACY_CONTRACT_IDS=CAIMQYXIXNYSAXIRQRAAG5ZTWP26476JX4SVAMDAOXRKLRCADUDKHOR5
#   SPLITTER_REFERRALS=true
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
