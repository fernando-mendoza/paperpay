# /etc/systemd/system/paperpay-api.service
# API de PaperPay (apps/api/dist/index.js). El catálogo viene en el release; los recibos de pago
# van a SQLite en /var/lib/paperpay/receipts.db (StateDirectory: sobrevive a reinicios y despliegues).
# scripts/deploy-vps.sh instala este archivo si cambió.
# Escucha solo en 127.0.0.1; el lado público es Caddy (detrás de Cloudflare).
[Unit]
Description=PaperPay API
Wants=network-online.target
After=network-online.target

[Service]
DynamicUser=yes
StateDirectory=paperpay
StateDirectoryMode=0700
EnvironmentFile=/etc/paperpay/api.env
Environment=HOST=127.0.0.1 PORT=8110 NODE_ENV=production
ExecStart=/opt/node/bin/node /opt/paperpay/api/dist/index.js
Restart=on-failure
RestartSec=10
MemoryMax=200M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
